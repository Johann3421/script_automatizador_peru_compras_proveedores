{
  "$schema": "https://opencode.ai/config.json",
  // Config especifica del proyecto Peru Compras
  // Excluye carpetas grandes del file watcher de OpenCode para evitar que el renderer se congele
  "watcher": {
    "ignore": [
      "venv",
      "dist",
      "build",
      "build_installer",
      "__pycache__",
      "*.pyc",
      "*.pyo"
    ]
  }
}
