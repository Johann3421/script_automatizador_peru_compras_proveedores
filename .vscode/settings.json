{
  "files.exclude": {
    "venv/": true,
    "dist/": true,
    "build/": true,
    "build_installer/": true,
    "__pycache__/": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true
  },
  "search.exclude": {
    "venv/": true,
    "dist/": true,
    "build/": true,
    "build_installer/": true,
    "__pycache__/": true,
    "**/*.pyc": true
  },
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/build_installer/**": true,
    "**/__pycache__/**": true
  },
  "python.analysis.exclude": [
    "venv",
    "dist",
    "build",
    "build_installer"
  ],
  "python.venvPath": ".",
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe"
}
